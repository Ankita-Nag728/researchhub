# Placeholders only. Never put secrets in frontend env files:
# anything starting with VITE_ is visible to every visitor.

# Where the dev server forwards /api requests (backend address)
VITE_API_PROXY_TARGET=http://localhost:8000

# Base path of the API as seen by the browser (keep as /api to stay same-origin)
VITE_API_BASE_URL=/api

# Public contact address shown on the Contact page (leave empty until you have one)
VITE_CONTACT_EMAIL=
