# Copy to backend/.env and fill in. Never commit the real .env file.

ENVIRONMENT=development            # development | test | production
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string

# Comma-separated browser origins allowed to call the API (https only in production)
FRONTEND_ORIGINS=http://localhost:5173

# Production must set COOKIE_SECURE=true (HTTPS only cookies)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

LOG_LEVEL=INFO

# Optional: send real password-reset emails (leave SMTP_HOST empty in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ResearchHub <no-reply@your-domain.example>
